# Copy to a private .env file on the NAS.  Do not commit that file.
SONGLOFT_PORT=58091
SONGLOFT_MUSIC_DIR=/srv/music
SONGLOFT_DATA_DIR=/srv/songloft-data
SONGLOFT_ADMIN_USERNAME=choose-a-local-admin-name
SONGLOFT_ADMIN_PASSWORD=replace-with-a-long-random-password
SONGLOFT_UID=1000
SONGLOFT_GID=1000
